{
  "name": "janmitra-backend",
  "version": "1.0.0",
  "description": "Backend API for JanMitra - AI assistant for government schemes",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:dynamo": "node scripts/seed-dynamo.js"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "routes/",
      "middleware/",
      "models/",
      "lib/",
      "config/"
    ],
    "ext": "js,json",
    "ignore": [
      "data/users.json",
      "node_modules/"
    ]
  },
  "keywords": [
    "government",
    "schemes",
    "india",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1001.0",
    "@aws-sdk/client-dynamodb": "^3.1001.0",
    "@aws-sdk/client-polly": "^3.1001.0",
    "@aws-sdk/client-translate": "^3.1001.0",
    "@aws-sdk/lib-dynamodb": "^3.1001.0",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
