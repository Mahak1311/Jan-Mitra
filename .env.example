# ─────────────────────────────────────────────
#  JanMitra — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=3000

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Amazon Web Services ───────────────────────
# Get these from the AWS Console → IAM → Security Credentials
# Or from your hackathon organizer's AWS account
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Optional — only needed for temporary credentials (e.g. AWS SSO / Kiro):
# AWS_SESSION_TOKEN=...

# ── Amazon Bedrock (Chat AI) ──────────────────
# Model IDs: https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html
# Fast & cheap:
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Higher quality (use when demoing):
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Amazon DynamoDB ───────────────────────────
# Run 'npm run seed:dynamo' once after setting AWS creds to create tables
DYNAMO_SCHEMES_TABLE=JanMitra_Schemes
DYNAMO_USERS_TABLE=JanMitra_Users

# ── MongoDB (optional, fileUserStore used by default) ────────
# MONGO_URI=mongodb://localhost:27017/janmitra

# ── Gemini (fallback if Bedrock is unavailable) ───────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 to Authorized JavaScript origins
# Add http://localhost:3000 to Authorized redirect URIs (not needed for token flow)
GOOGLE_CLIENT_ID=50421657406-2vhkijs8sq5pani3aq5lg3okpo32va7v.apps.googleusercontent.com
